# ==============================================================================
# AWESOME ADVENTURE TOURS / MAHMOUD CRM — ENVIRONMENT CONFIGURATION
# ==============================================================================
# Target Canonical Production Domain: https://awesomeadventure.tours
# Authoritative Production Supabase Project: cyifhjqqvtiguitrziqs
# Hostinger Business Web Hosting Node.js Runtime (Node 20+ / Node 22+ LTS)
# ==============================================================================

# ==============================================================================
# SECTION A: HOSTINGER SERVER-ONLY ENVIRONMENT VARIABLES (PRIVATE)
# ------------------------------------------------------------------------------
# Configure these variables in Hostinger hPanel > Node.js > Environment Settings
# or in the root production .env file on the server.
#
# CRITICAL SECURITY RULES:
# - NEVER prefix these server-only variables with 'VITE_'.
# - NEVER expose these private secrets to Vite, browser client bundles, or Git.
# ==============================================================================

# 1. Node.js Runtime & Network (Hostinger Web App Manager)
# Hostinger automatically injects PORT dynamically; 3000 is default local fallback.
PORT=3000
NODE_ENV=production
APP_URL=https://awesomeadventure.tours

# 2. Server-Side Supabase Access (Authoritative Project: cyifhjqqvtiguitrziqs)
# URL of the authoritative production Supabase project
SUPABASE_URL=https://cyifhjqqvtiguitrziqs.supabase.co

# Supabase Service-Role / Secret Key (SERVER-SIDE ONLY)
# Used exclusively by the Express backend for authoritative validations, rate-limit buckets,
# and administrative bootstrapping. NEVER expose to the browser!
# Format: modern secret key (sb_secret_...) or legacy JWT service_role key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_secret_key_here

# Supabase Server-side Anon Public Fallback Key
SUPABASE_ANON_KEY=your_supabase_anon_publishable_key_here

# Supabase Direct PostgreSQL Connection (Optional: for backend scripts & pooler)
# Hostinger connects directly to Supabase AWS Frankfurt pooler (port 6543)
# DATABASE_URL=postgresql://postgres.cyifhjqqvtiguitrziqs:[YOUR-DB-PASSWORD]@aws-0-eu-central-1.pooler.supabase.com:6543/postgres

# 3. Google Gemini AI Concierge (SERVER-SIDE ONLY)
# Required for server-side /api/chat Concierge bot proxy (gemini-3.8-flash)
# Strictly kept on server to prevent client-side quota theft
GEMINI_API_KEY=your_google_gemini_api_key_here

# 4. Payment Gateways (SERVER-SIDE ONLY)
# Secret keys for payment processing and webhook signature validation
# STRIPE_SECRET_KEY=sk_live_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# PAYPAL_CLIENT_SECRET=your_paypal_secret_here
# PAYMOB_API_KEY=your_paymob_api_key_here

# 5. Communications & Notification Relays (SERVER-SIDE ONLY)
# RESEND_API_KEY=re_...
# SMTP_HOST=smtp.hostinger.com
# SMTP_PORT=465
# SMTP_USER=reservations@awesomeadventure.tours
# SMTP_PASSWORD=your_email_password_here
# WHATSAPP_CLOUD_API_TOKEN=your_meta_whatsapp_token_here

# 6. Initial Administrator Bootstrap Account (CLI Only)
ADMIN_EMAIL=admin@awesomeadventure.tours
# ADMIN_PASSWORD=your_secure_admin_password_here


# ==============================================================================
# SECTION B: FRONTEND CLIENT CONFIGURATION (PUBLIC / BROWSER-SAFE)
# ------------------------------------------------------------------------------
# These variables start with 'VITE_' and ARE COMPILED INTO THE JAVASCRIPT BUNDLE.
# Only place publicly safe credentials here.
# ==============================================================================

# Authoritative Supabase Project URL (Safe for browser client)
VITE_SUPABASE_URL=https://cyifhjqqvtiguitrziqs.supabase.co

# Supabase Public Anon API Key (Safe for browser client under RLS)
# Supports modern Supabase publishable keys (sb_publishable_...) or standard anon JWTs
VITE_SUPABASE_ANON_KEY=your_supabase_anon_publishable_key_here

# Public Website Canonical URL
VITE_APP_URL=https://awesomeadventure.tours

# Public Payment Gateway Publishable Key (Safe for client checkout elements)
# VITE_STRIPE_PUBLIC_KEY=pk_live_...

# Pier Desk Public Hotlines & Contact Channels (Displayed on public vouchers & header)
VITE_HOTLINE=+20 102 345 6789
VITE_WHATSAPP_NUMBER=+201023456789
VITE_SUPPORT_EMAIL=reservations@awesomeadventure.tours
