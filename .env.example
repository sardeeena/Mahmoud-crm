# ==============================================================================
# AWESOME ADVENTURE TOURS / MAHMOUD CRM - PRODUCTION ENVIRONMENT CONFIGURATION
# ==============================================================================
# Target Canonical Production Domain: https://awesomeadventure.tours
# Authoritative Production Supabase Project: cyifhjqqvtiguitrziqs
# Hostinger Business Web Hosting Node.js Runtime (Node 20+ / Node 22+)
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. SERVER & RUNTIME CONFIGURATION (Hostinger Node.js Application Manager)
# ------------------------------------------------------------------------------
# Hostinger dynamically injects PORT; default fallback is 3000 for local testing.
PORT=3000

# Application environment mode ('production' on Hostinger, 'development' for local)
NODE_ENV=production

# Canonical production website origin (used for absolute URLs, sitemap, CORS)
APP_URL=https://awesomeadventure.tours

# ------------------------------------------------------------------------------
# 2. SUPABASE AUTHORITATIVE DATABASE CONFIGURATION
# ------------------------------------------------------------------------------
# Project ID: cyifhjqqvtiguitrziqs
# Retrieve credentials from: Supabase Dashboard > Project Settings > API
#
# Production Project URL (Client & Server)
VITE_SUPABASE_URL=https://cyifhjqqvtiguitrziqs.supabase.co
SUPABASE_URL=https://cyifhjqqvtiguitrziqs.supabase.co

# Supabase Public / Anon API Key (Safe for browser client)
# Supports standard JWT tokens (eyJ...) or modern publishable keys (sb_publishable_...)
VITE_SUPABASE_ANON_KEY=your_supabase_anon_publishable_key_here
SUPABASE_ANON_KEY=your_supabase_anon_publishable_key_here

# ------------------------------------------------------------------------------
# 3. SUPABASE SECRETS & ADMINISTRATIVE MAINTENANCE (SERVER-ONLY / CLI)
# ------------------------------------------------------------------------------
# CRITICAL SECURITY RULE:
# NEVER commit the service-role key or expose it to frontend code or client bundles!
# Used exclusively for server-side provisioning scripts (e.g. scripts/setup-admin.ts)
# SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_secret_key_here

# Initial back-office admin account for CLI bootstrap
ADMIN_EMAIL=admin@awesomeadventure.tours
# ADMIN_PASSWORD=your_secure_random_admin_password_here

# ------------------------------------------------------------------------------
# 4. GOOGLE GEMINI AI CONCIERGE CHATBOT
# ------------------------------------------------------------------------------
# Required for /api/chat Concierge bot (gemini-3.8-flash)
# Get your API key from Google AI Studio: https://aistudio.google.com/
GEMINI_API_KEY=your_google_gemini_api_key_here

# ------------------------------------------------------------------------------
# 5. OPERATIONAL COMMUNICATIONS & NOTIFICATIONS (Optional / Pier Desk)
# ------------------------------------------------------------------------------
# Pier Desk WhatsApp hotline for instant departure vouchers and guest support
VITE_WHATSAPP_NUMBER=+201023456789
VITE_SUPPORT_EMAIL=reservations@awesomeadventure.tours
VITE_HOTLINE=+20 102 345 6789

# ------------------------------------------------------------------------------
# 6. PAYMENT GATEWAYS (Optional - Pay at Pickup is default enabled)
# ------------------------------------------------------------------------------
# Stripe / Paymob online card processing credentials (when online gateway is enabled)
# STRIPE_PUBLISHABLE_KEY=pk_live_...
# STRIPE_SECRET_KEY=sk_live_...
# PAYMOB_API_KEY=...
# PAYMOB_INTEGRATION_ID=...
